# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mayda Infra — Global Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── General ──────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_PASSWORD=changeme_secure_password_here

# ── Backend API (mayda-backend) ──────────────────────
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
SERVICE_TOKEN=changme_service_token_shared_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_PORT=8001

# CORS — regex matching allowed origins
BACKEND_CORS_ORIGIN_REGEX=.*

# ── Twilio SMS (optional) ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Guidini (optional) ───────────────────────────────
GUIDINI_APP_KEY=
GUIDINI_API_KEY=

# ── AI Service (mayda-ai) ────────────────────────────
BACKEND_API_TIMEOUT=30
GATEWAY_ORIGIN=http://localhost:3000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL=tiny
